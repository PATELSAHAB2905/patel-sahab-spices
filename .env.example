# Patel Sahab Spices - Environment Configuration Example
# (Optional: You can also configure Firebase and Google Sheets directly in the Admin Panel UI)

# Firebase Cloud Firestore Configuration
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=patel-sahab-spices.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=patel-sahab-spices
VITE_FIREBASE_STORAGE_BUCKET=patel-sahab-spices.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Google Apps Script Web App URL (Optional)
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec
